{
  "name": "pairsync",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp run -r test",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:native": "vp run --filter native dev",
    "dev:web": "vp run --filter web dev",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
    "postinstall": "varlock codegen --path ./apps/web/ || true && varlock codegen --path ./apps/native/ || true",
    "build:desktop": "pnpm --filter web desktop:build"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pairsync/config": "workspace:*",
    "@types/node": "^22.20.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rolldown": "1.2.13",
    "typescript": "^6.0.3",
    "varlock": "catalog:",
    "vite-plus": "1.1.0"
  },
  "packageManager": "pnpm@11.21.0"
}
