{
  "expo": {
    "scheme": "pairsync",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "name": "pairsync",
    "slug": "pairsync",
    "ios": {
      "bundleIdentifier": "com.pairsync.app"
    },
    "android": {
      "package": "com.pairsync.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/withMulticastEntitlement",
      "./plugins/withAndroidMulticastPermissions"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
