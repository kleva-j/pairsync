{
  "expo": {
    "scheme": "pairsync",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "pairsync",
    "slug": "pairsync",
    "ios": {
      "bundleIdentifier": "com.pairsync.app"
    },
    "android": {
      "package": "com.pairsync.app"
    },
    "plugins": ["expo-font"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
